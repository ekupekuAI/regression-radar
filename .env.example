# Copy this file to .env and fill in real values. Never commit .env.

# Personal - each person makes their own.
# github.com/settings/tokens - no special scopes needed for public repo reads.
GITHUB_TOKEN=

# Shared team service. ONE Hindsight Cloud instance for the whole team -
# the memory bank lives inside a specific instance, so the loader and the
# deployed app must point at the same one.
HINDSIGHT_API_URL=
HINDSIGHT_API_KEY=

# For our own agent layer. console.groq.com
GROQ_API_KEY=

# Optional. "on" makes /api/baseline call Groq on every check. Anything else
# serves the recorded run in data/baseline-recorded.json and never calls Groq.
BASELINE_LIVE=
